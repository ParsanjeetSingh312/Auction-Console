# ==============================================================================
# IPL Auction RAG Backend — configuration template
#
# Copy to .env and fill in what you need:   cp .env.example .env
# Then check it:                            python -m config.env_check
#
# Nothing here is required. With no keys at all the agent still runs: retrieval,
# search and the deterministic analyst all work offline. Keys only add written
# LLM analysis.
# ==============================================================================

# --- Language model (optional) ------------------------------------------------
# Pick ONE provider.
#
#   Gemini:     https://aistudio.google.com/apikey   keys begin "AIza"     free
#   Groq:       https://console.groq.com/keys        keys begin "gsk_"     free
#   Anthropic:  https://console.anthropic.com/       keys begin "sk-ant-"  PAID
#
# Note the Gemini free tier allows 5 requests/minute; over that, requests are
# rejected and the agent falls back to the deterministic analyst for that turn.
GEMINI_API_KEY=
GROQ_API_KEY=

# Claude. SCOUT asks for this engine by name; the console's own search and chat
# do not. So filling this in adds a capability without moving anything that
# already works onto a paid model. Left blank, SCOUT falls back to whichever
# free provider is configured, and says in its notes that it did.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Hermes (SCOUT's reasoning engine) ----------------------------------------
# An OpenAI-compatible Hermes endpoint. SCOUT asks for it by name, so it never
# serves the console's own search or chat -- only the advisor, and only when it
# is reachable. Blank means "not configured" and the advisor quietly uses the
# providers above instead.
#
# Include the /v1 suffix. Whatever speaks this protocol works here:
#   a teammate's server   http://192.168.1.x:8642/v1   (a LAN address, not
#                                                        their localhost)
#   an SSH tunnel         http://localhost:8642/v1
#   Ollama on this box    http://localhost:11434/v1
HERMES_API_BASE_URL=

# Hermes is open source and most local servers want no key. Leave blank and no
# Authorization header is sent at all, which is what an unauthenticated server
# expects -- a bare "Bearer " is rejected by some rather than ignored.
HERMES_API_KEY=

# Must match what the server answers to, not what the model is called in prose.
# Ask it:   curl {HERMES_API_BASE_URL}/models
HERMES_RESEARCHER_MODEL=hermes3:8b
HERMES_ADVISOR_MODEL=hermes3:70b

# Seconds, and a ceiling rather than a target. The advisor passes something
# shorter when a lot is live: the room opens a lot for 7 seconds, so an answer
# that takes 20 is an answer that arrives after the hammer.
HERMES_TIMEOUT=20

# Whether the Data Researcher also sends its extraction reasoning to Hermes.
# Off by default -- that hop sits inside a loop that runs once per scraped
# page, so it is paid per source rather than per question.
SCOUT_RESEARCHER_USES_HERMES=false

# Which provider serves a request: auto | gemini | groq | anthropic
#
# "auto" is a ladder: Anthropic, then Gemini, then Groq, falling through to the
# next rung when one fails mid-request -- a 503, a rate limit, a bad key. With
# no Anthropic key it simply starts at Gemini, so nothing here changes on the
# day you add one.
#
# Naming a provider PINS it and turns the ladder off. Use that when you want to
# be certain which vendor is serving you; leave it on "auto" when you would
# rather have an answer.
LLM_PROVIDER=auto

# --- Models -------------------------------------------------------------------
# Gemini covers text-to-SQL, synthesis and SCOUT's own work.
#
# 2.5-flash rather than 3.5-flash, from measurement rather than version
# number: over 5 calls each, 2.5 ran at a 2.0s median with no failures and
# 3.5 at 7.7s with 2 of 5 failing. A search makes up to three model calls.
GEMINI_MODEL=gemini-2.5-flash

# Routing is a three-way classification, so it runs on the lite model: measured
# at 1.2s against 4.6s, and every query routes before it does anything else.
#
# Note the lite models reject the `thinkingConfig` parameter that the Flash
# models need, with a 400. rag/llm_provider.py detects that and retries without
# it, so any model name you put here will work either way.
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite

# Groq uses a model per task. These names go stale: the llama-* set that was
# here was retired and returned 404 on every call. Check the current list with
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#
# Measured 2026-09-19, 5 calls each: qwen3.8-27b 0.48s median (fastest, clean
# SQL), gpt-oss-120b 1.03s (clean SQL), gpt-oss-20b failed 3 of 5.
RAG_LLM_MODEL=openai/gpt-oss-120b
# SQL on qwen rather than gpt-oss: gpt-oss reasons, and those tokens come out
# of the 300 text_to_sql allows -- 248 of them, leaving a statement truncated
# mid-expression. qwen: 5/5 valid statements on the real path.
SQL_LLM_MODEL=qwen/qwen3.8-27b
ROUTER_LLM_MODEL=qwen/qwen3.8-27b

# Per-task Groq keys. Leave blank to inherit GROQ_API_KEY; they exist only for
# splitting usage across separate accounts, and do not apply to Gemini.
TEXT_TO_SQL_API_KEY=
RAG_SYNTHESIS_API_KEY=
QUERY_ROUTER_API_KEY=

# --- Local CPU models ---------------------------------------------------------
# Downloaded once (~2.4 GB) to ~/.cache/huggingface, then loaded offline.
# No key needed — both repositories are public.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-large

# Optional: only for gated models or higher download rate limits.
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# --- Server -------------------------------------------------------------------
# The backend serves the built console at / and the API at /api/v1/*, so this
# port is the whole application.
API_HOST=0.0.0.0
API_PORT=8001

# Only needed when the frontend runs separately under `npm run dev` on :5173.
# A production build is same-origin and needs no entry here.
CORS_ORIGINS=http://localhost:5173,http://localhost:8001

# --- Retrieval ----------------------------------------------------------------
# Vector search returns this many candidates, the cross-encoder reranks them
# down to RERANK_TOP_K. RERANK_TOP_K must not exceed VECTOR_SEARCH_TOP_K.
VECTOR_SEARCH_TOP_K=20
RERANK_TOP_K=5

# ==============================================================================
# SCOUT orchestrator
#
# All optional. An unset value here costs SCOUT a capability and costs the rest
# of the backend nothing, the same bargain the language-model keys make above.
#
# One rule worth knowing: a key written as `NAME=` with nothing after it is an
# empty string, not an absent setting -- pydantic-settings will use "" rather
# than the default. That is harmless for an API key, whose default is "" anyway,
# and destructive for a path. So the two path settings below are commented out
# rather than left blank.
# ==============================================================================

# --- Web acquisition ----------------------------------------------------------
# The Data Researcher reads only what this file lists. Commented out = use the
# sources.yaml sitting beside config/settings.py.
# SCOUT_SOURCES_PATH=

# false opens a visible browser window, which is the only practical way to debug
# a selector that has quietly stopped matching.
PLAYWRIGHT_HEADLESS=true

# Seconds. A source slower than SCRAPE_TIMEOUT is recorded as a failure and
# handed to the search fallback, so one unresponsive site cannot stall the
# graph. REQUEST_DELAY is the politeness gap between two requests to the same
# host; sources.yaml may raise it per source, never lower it.
SCOUT_SCRAPE_TIMEOUT=20
SCOUT_REQUEST_DELAY=2

# Sent on every request, so an operator can rate-limit or block this crawler
# deliberately rather than by guesswork.
SCOUT_USER_AGENT=AuctiqScout/1.0 (+auction research bot)

# Skip paths a source's robots.txt disallows.
SCOUT_RESPECT_ROBOTS=true

# --- Search fallback ----------------------------------------------------------
# Used when a scrape times out or meets an anti-bot challenge, which the scraper
# reports rather than tries to defeat. Free tier is 1,000 searches/month.
#
#   Tavily:  https://tavily.com
#
# Blank means the fallback declares itself unavailable instead of raising.
TAVILY_API_KEY=
SCOUT_SEARCH_MAX_RESULTS=5

# --- Research store -----------------------------------------------------------
# Scraped facts get their own Chroma collection. They must not go into
# `ipl_players`: POST /api/v1/ingest defaults to reset=True, which drops that
# collection and rebuilds it from the spreadsheet, so research written there
# would disappear on the next ingest without an error anywhere.
SCOUT_COLLECTION_NAME=scout_research

# --- Graph --------------------------------------------------------------------
# Where LangGraph checkpoints live. Commented out = data/database/
# scout_checkpoints.db, which .gitignore already covers. See the note above
# about why this is not left blank.
# SCOUT_CHECKPOINT_PATH=

# How many times the Advisor may hand a query back to the Researcher for fresh
# data before answering with what it has, and the wall clock for that refresh.
# The auction opens a lot for 7 seconds and closes it 7 seconds after the last
# bid, so a longer budget buys a better answer that arrives after the hammer.
SCOUT_MAX_REFRESH_CYCLES=1
SCOUT_CYCLE_TIMEOUT=8
