# Dependencies
node_modules/
.venv/

# Build output. `dist/` is what the backend serves, so it must exist locally —
# but it is generated by `npm run build`, never edited, and would otherwise
# produce a diff on every build.
dist/
tsconfig.tsbuildinfo

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets. .env holds live API keys and must never be committed.
.env
.env.*
!.env.example

# Backup copies, which are the quiet way a secret reaches a public repo: the
# .env rule above does not match a file called `settings.py.bak` or
# `pool_metadata.json.bak-230617`, and a backup taken before editing a config
# file tends to contain exactly the values the original was being edited to
# protect. Ignore the shape, not the individual file.
*.bak
*.bak-*
*.backup
*.backup-*
*.orig
*~

# Data stores. These are state, rebuilt by POST /api/v1/ingest — and the Chroma
# directory accumulates an orphaned index folder per re-ingest.
ipl_auction_rag_backend/data/database/*.db
ipl_auction_rag_backend/data/database/*.db-shm
ipl_auction_rag_backend/data/database/*.db-wal
ipl_auction_rag_backend/data/database/chroma_db/

# Datasets SCOUT downloads. Fetched by the scraper, rebuilt on demand, and
# large -- the Cricsheet IPL archive alone is 5 MB of binary. The .gitkeep
# keeps the directory itself.
ipl_auction_rag_backend/data/raw/*
!ipl_auction_rag_backend/data/raw/.gitkeep

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- private keys, wherever they land ----------------------------------------
# Added 2026-10-10 after `ssh-keygen` run from the repository root wrote a key
# pair here: the private half sat unignored in the project folder, one `git add
# .` away from being published. Nothing leaked, but only because it was caught
# before the first commit.
#
# Filename patterns are a weak defence -- that key was called "Auction-Console",
# which no pattern below would match. The real rule is that keys live in
# ~/.ssh and never in a repository. These catch the common accidents.
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_dsa
*_ecdsa
*_ed25519
*.pem
*.ppk
*.p12
*.pfx
*.key

# Per-deployment record of the last career-stats refresh (scout/stats_refresh.py).
# Each environment writes its own; committing one would tell a fresh deploy it
# had already refreshed.
ipl_auction_rag_backend/data/stats_status.json
