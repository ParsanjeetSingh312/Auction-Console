# Dependencies
node_modules/
.venv/

# Build output. `dist/` is what the backend serves, so it must exist locally —
# but it is generated by `npm run build`, never edited, and would otherwise
# produce a diff on every build.
dist/
tsconfig.tsbuildinfo

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets. .env holds live API keys and must never be committed.
.env
.env.*
!.env.example

# Data stores. These are state, rebuilt by POST /api/v1/ingest — and the Chroma
# directory accumulates an orphaned index folder per re-ingest.
ipl_auction_rag_backend/data/database/*.db
ipl_auction_rag_backend/data/database/*.db-shm
ipl_auction_rag_backend/data/database/*.db-wal
ipl_auction_rag_backend/data/database/chroma_db/

# Datasets SCOUT downloads. Fetched by the scraper, rebuilt on demand, and
# large -- the Cricsheet IPL archive alone is 5 MB of binary. The .gitkeep
# keeps the directory itself.
ipl_auction_rag_backend/data/raw/*
!ipl_auction_rag_backend/data/raw/.gitkeep

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
